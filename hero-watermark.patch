diff --git a/crates/keyroost/src/main.rs b/crates/keyroost/src/main.rs
index b3378f9..31a4429 100644
--- a/crates/keyroost/src/main.rs
+++ b/crates/keyroost/src/main.rs
@@ -562,6 +562,12 @@ fn main() -> eframe::Result<()> {
 struct App {
     /// Active PC/SC session, if any.
     session: Option<Session>,
+    /// Lazily-loaded background watermark textures (light-ink for the dark
+    /// theme, dark-ink for the light theme). `Some(None)` = tried and the asset
+    /// was absent, so we don't retry each frame. Branding-only; absent in an
+    /// unbranded build.
+    wm_dark_theme: Option<Option<egui::TextureHandle>>,
+    wm_light_theme: Option<Option<egui::TextureHandle>>,
     /// Last device info read.
     info: Option<DeviceInfo>,
     /// Whether the session has been authenticated.
@@ -2939,6 +2945,43 @@ impl App {
         )
     }
 
+    /// Load a branding watermark PNG from the assets dir into a texture, caching
+    /// the result (including "absent") so we touch disk only once. Returns the
+    /// texture for the active theme, or None in an unbranded build.
+    fn watermark_texture(&mut self, ctx: &egui::Context) -> Option<egui::TextureHandle> {
+        let dark = matches!(self.mode, Mode::Dark);
+        let slot = if dark { &mut self.wm_dark_theme } else { &mut self.wm_light_theme };
+        if slot.is_none() {
+            let file = if dark { "hero-watermark-light.png" } else { "hero-watermark-dark.png" };
+            let path = std::path::Path::new("crates/keyroost/assets/branding").join(file);
+            let loaded = std::fs::read(&path)
+                .ok()
+                .and_then(|bytes| decode_png_rgba(&bytes))
+                .map(|img| ctx.load_texture(format!("watermark-{file}"), img, egui::TextureOptions::LINEAR));
+            *slot = Some(loaded);
+        }
+        slot.as_ref().and_then(|o| o.clone())
+    }
+
+    /// Paint the branding watermark, if present, faintly behind `rect`. The asset
+    /// is tall (~1:2.35); scale to cover width and top-anchor it. Per-theme
+    /// opacity: white ink on dark needs more alpha than dark ink on light.
+    fn paint_watermark(&mut self, ui: &egui::Ui, rect: egui::Rect) {
+        let Some(tex) = self.watermark_texture(ui.ctx()) else { return; };
+        let size = tex.size_vec2();
+        if size.x <= 0.0 { return; }
+        let scale = rect.width() / size.x;
+        let draw = egui::Rect::from_min_size(rect.min, size * scale);
+        let alpha = if matches!(self.mode, Mode::Dark) { 0.34 } else { 0.15 };
+        let tint = egui::Color32::from_white_alpha((alpha * 255.0) as u8);
+        ui.painter().image(
+            tex.id(),
+            draw,
+            egui::Rect::from_min_max(egui::pos2(0.0, 0.0), egui::pos2(1.0, 1.0)),
+            tint,
+        );
+    }
+
     /// The currently selected device, if the id still resolves to a present one.
     fn selected_device(&self) -> Option<&UiDevice> {
         let id = self.selected_device.as_ref()?;
@@ -3994,6 +4037,26 @@ fn paint_check_icon(ui: &egui::Ui, center: egui::Pos2, color: egui::Color32) {
 }
 
 /// Cross — delete / dismiss.
+/// Decode raw PNG bytes into an egui image (RGBA8) for branding assets loaded
+/// from disk (the background watermark).
+fn decode_png_rgba(bytes: &[u8]) -> Option<egui::ColorImage> {
+    let decoder = png::Decoder::new(std::io::Cursor::new(bytes));
