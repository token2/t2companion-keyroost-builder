+        png::ColorType::Grayscale => data.iter().flat_map(|&g| [g, g, g, 255]).collect(),
+        _ => return None,
+    };
+    if rgba.len() != w * h * 4 { return None; }
+    Some(egui::ColorImage::from_rgba_unmultiplied([w, h], &rgba))
+}
